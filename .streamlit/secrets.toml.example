# Streamlit Cloud Secrets — paste these in your Streamlit Cloud app settings
# Go to: share.streamlit.io → Your App → Settings → Secrets

IBM_API_KEY = "your_ibm_api_key_here"
IBM_PROJECT_ID = "your_ibm_project_id_here"
IBM_WATSONX_URL = "https://us-south.ml.cloud.ibm.com"
IBM_GRANITE_MODEL_ID = "ibm/granite-3-8b-instruct"
OPENWEATHER_API_KEY = "your_openweather_api_key_here"
