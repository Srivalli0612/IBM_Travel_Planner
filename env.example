# ============================================================
#  IBM watsonx.ai / Granite Configuration
# ============================================================

# IBM watsonx.ai API Key — obtain from IBM Cloud > Manage > API keys
IBM_API_KEY=your_ibm_api_key_here

# IBM watsonx.ai project ID — found in your watsonx.ai project settings
IBM_PROJECT_ID=your_ibm_project_id_here

# IBM watsonx.ai service URL (region-specific)
# Options: https://us-south.ml.cloud.ibm.com
#          https://eu-de.ml.cloud.ibm.com
#          https://eu-gb.ml.cloud.ibm.com
#          https://jp-tok.ml.cloud.ibm.com
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model to use (IBM Cloud Lite compatible)
# granite-13b-chat-v2  — conversational, best for itinerary & Q&A
# granite-3-8b-instruct — lightweight, fast, free tier friendly
IBM_GRANITE_MODEL_ID=ibm/granite-4-h-small

# ============================================================
#  Optional: OpenWeatherMap (free tier — 60 calls/min)
#  https://openweathermap.org/api
# ============================================================
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ============================================================
#  Flask Application Settings
# ============================================================
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=travel-planner-secret-key-change-in-production
PORT=5000
